<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#040404"/>
      <stop offset="50%" stop-color="#0a0a0d"/>
      <stop offset="100%" stop-color="#14141a"/>
    </linearGradient>
    <linearGradient id="cyanAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#d4af37"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1600" height="900" fill="url(#bg3)"/>

  <!-- Matrix Coordinates Grid -->
  <g stroke="#ffffff" stroke-opacity="0.03" stroke-width="1">
    <line x1="250" y1="0" x2="250" y2="900"/>
    <line x1="550" y1="0" x2="550" y2="900"/>
    <line x1="850" y1="0" x2="850" y2="900"/>
    <line x1="1150" y1="0" x2="1150" y2="900"/>
    <line x1="1450" y1="0" x2="1450" y2="900"/>
    <line x1="0" y1="225" x2="1600" y2="225"/>
    <line x1="0" y1="450" x2="1600" y2="450"/>
    <line x1="0" y1="675" x2="1600" y2="675"/>
  </g>

  <!-- Telegram AI Bot Console & Agentic Pipeline -->
  <g transform="translate(160, 110)">
    <!-- Container Frame -->
    <rect width="1280" height="680" rx="4" fill="#000000" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1"/>
    
    <!-- Top terminal prompt bar -->
    <rect width="1280" height="54" fill="#09090b" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"/>
    <circle cx="28" cy="27" r="5" fill="#262626"/>
    <circle cx="48" cy="27" r="5" fill="#262626"/>
    <circle cx="68" cy="27" r="5" fill="#262626"/>
    <text x="110" y="32" fill="#737373" font-family="monospace" font-size="12" letter-spacing="2">AGENTIC WORKFLOW DISPATCH // TELEGRAM BOT ORCHESTRATOR</text>
    <text x="1140" y="32" fill="#d4af37" font-family="monospace" font-size="11" letter-spacing="1">STATUS: RUNNING (PID 8821)</text>

    <!-- Chat / Message Stream Left Column -->
    <rect x="36" y="80" width="460" height="560" fill="#070709" stroke="#ffffff" stroke-opacity="0.06"/>
    <text x="60" y="115" fill="#a3a3a3" font-family="monospace" font-size="11" letter-spacing="2">INCOMING USER SESSIONS</text>

    <!-- Message 1 -->
    <g transform="translate(60, 140)">
      <rect width="360" height="60" rx="3" fill="#141416" stroke="#ffffff" stroke-opacity="0.06"/>
      <text x="16" y="24" fill="#737373" font-family="monospace" font-size="10">USER @developer_lead • 14:02:11</text>
      <text x="16" y="44" fill="#ffffff" font-family="monospace" font-size="12">/analyze repository and dispatch CI run</text>
    </g>

    <!-- Agent Response 1 -->
    <g transform="translate(60, 220)">
      <rect width="380" height="110" rx="3" fill="#101014" stroke="#d4af37" stroke-opacity="0.3"/>
      <text x="16" y="24" fill="#d4af37" font-family="monospace" font-size="10">AGENT SYSTEM RESPONSE // TASK-921</text>
      <text x="16" y="48" fill="#e5e5e5" font-family="monospace" font-size="11">✓ Git workspace cloned and audited</text>
      <text x="16" y="70" fill="#e5e5e5" font-family="monospace" font-size="11">✓ Running 14 security AST linters</text>
      <text x="16" y="92" fill="#10b981" font-family="monospace" font-size="11">→ 0 critical vulnerabilities found</text>
    </g>

    <!-- Message 2 -->
    <g transform="translate(60, 350)">
      <rect width="360" height="60" rx="3" fill="#141416" stroke="#ffffff" stroke-opacity="0.06"/>
      <text x="16" y="24" fill="#737373" font-family="monospace" font-size="10">USER @cto_alex • 14:04:39</text>
      <text x="16" y="44" fill="#ffffff" font-family="monospace" font-size="12">/deploy preview to Asia-South region</text>
    </g>

    <g transform="translate(60, 430)">
      <rect width="380" height="90" rx="3" fill="#101014" stroke="#ffffff" stroke-opacity="0.08"/>
      <text x="16" y="24" fill="#d4af37" font-family="monospace" font-size="10">AGENT DISPATCH PIPELINE</text>
      <text x="16" y="50" fill="#a3a3a3" font-family="monospace" font-size="11">Routing through Kubernetes cluster API</text>
      <text x="16" y="72" fill="#10b981" font-family="monospace" font-size="11">✓ Ingress DNS healthy • SSL auto-certified</text>
    </g>

    <!-- Right Side: DAG Graph & Neural Dispatch Engine -->
    <rect x="520" y="80" width="724" height="560" fill="#060608" stroke="#ffffff" stroke-opacity="0.06"/>
    <text x="550" y="115" fill="#a3a3a3" font-family="monospace" font-size="11" letter-spacing="2">AGENTIC DAG WORKFLOW TOPOLOGY</text>

    <!-- DAG Nodes and Flow -->
    <g transform="translate(560, 160)">
      <!-- Input Node -->
      <rect x="0" y="140" width="140" height="60" rx="2" fill="#121214" stroke="#ffffff" stroke-opacity="0.2"/>
      <text x="70" y="168" fill="#ffffff" font-family="monospace" font-size="11" text-anchor="middle">NLP ROUTER</text>
      <text x="70" y="186" fill="#737373" font-family="monospace" font-size="9" text-anchor="middle">INTENT CLASSIFIER</text>

      <!-- Connecting Lines -->
      <line x1="140" y1="170" x2="240" y2="90" stroke="#d4af37" stroke-width="1.5"/>
      <line x1="140" y1="170" x2="240" y2="170" stroke="#d4af37" stroke-width="1.5"/>
      <line x1="140" y1="170" x2="240" y2="250" stroke="#d4af37" stroke-width="1.5"/>

      <!-- Middle Agent Nodes -->
      <rect x="240" y="60" width="160" height="60" rx="2" fill="#17171a" stroke="#d4af37" stroke-width="1"/>
      <text x="320" y="88" fill="#d4af37" font-family="monospace" font-size="11" text-anchor="middle">CODE ANALYSIS</text>
      <text x="320" y="106" fill="#a3a3a3" font-family="monospace" font-size="9" text-anchor="middle">AST EVALUATION</text>

      <rect x="240" y="140" width="160" height="60" rx="2" fill="#17171a" stroke="#d4af37" stroke-width="1"/>
      <text x="320" y="168" fill="#d4af37" font-family="monospace" font-size="11" text-anchor="middle">CLOUD TOOLING</text>
      <text x="320" y="186" fill="#a3a3a3" font-family="monospace" font-size="9" text-anchor="middle">API PROVISIONING</text>

      <rect x="240" y="220" width="160" height="60" rx="2" fill="#17171a" stroke="#d4af37" stroke-width="1"/>
      <text x="320" y="248" fill="#d4af37" font-family="monospace" font-size="11" text-anchor="middle">DATA SYNTHESIS</text>
      <text x="320" y="266" fill="#a3a3a3" font-family="monospace" font-size="9" text-anchor="middle">CONTEXT MEMORY</text>

      <!-- Merge to output -->
      <line x1="400" y1="90" x2="490" y2="170" stroke="#ffffff" stroke-opacity="0.3"/>
      <line x1="400" y1="170" x2="490" y2="170" stroke="#ffffff" stroke-opacity="0.3"/>
      <line x1="400" y1="250" x2="490" y2="170" stroke="#ffffff" stroke-opacity="0.3"/>

      <rect x="490" y="140" width="150" height="60" rx="2" fill="#1a1a1f" stroke="#ffffff" stroke-opacity="0.3"/>
      <text x="565" y="168" fill="#ffffff" font-family="monospace" font-size="11" text-anchor="middle">EXECUTION GATE</text>
      <text x="565" y="186" fill="#10b981" font-family="monospace" font-size="9" text-anchor="middle">TELEGRAM DISPATCH</text>
    </g>

    <!-- Bottom telemetry ticker -->
    <g transform="translate(550, 520)">
      <text x="0" y="20" fill="#737373" font-family="monospace" font-size="11">MODEL: GEMINI / REASONING AGENT</text>
      <text x="280" y="20" fill="#737373" font-family="monospace" font-size="11">TOKENS/SEC: 142.6</text>
      <text x="470" y="20" fill="#d4af37" font-family="monospace" font-size="11">DECISION ACCURACY: 99.4%</text>
    </g>
  </g>
</svg>
