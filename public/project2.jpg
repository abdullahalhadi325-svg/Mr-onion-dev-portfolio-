<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#040405"/>
      <stop offset="60%" stop-color="#09090b"/>
      <stop offset="100%" stop-color="#141416"/>
    </linearGradient>
    <linearGradient id="goldNode" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#d4af37"/>
      <stop offset="100%" stop-color="#aa8520"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1600" height="900" fill="url(#bg2)"/>

  <!-- Subtle Blueprint Grid -->
  <g stroke="#ffffff" stroke-opacity="0.03" stroke-width="1">
    <line x1="200" y1="0" x2="200" y2="900"/>
    <line x1="500" y1="0" x2="500" y2="900"/>
    <line x1="800" y1="0" x2="800" y2="900"/>
    <line x1="1100" y1="0" x2="1100" y2="900"/>
    <line x1="1400" y1="0" x2="1400" y2="900"/>
    <line x1="0" y1="200" x2="1600" y2="200"/>
    <line x1="0" y1="450" x2="1600" y2="450"/>
    <line x1="0" y1="700" x2="1600" y2="700"/>
  </g>

  <!-- ERP Dashboard & Topology Architecture Frame -->
  <g transform="translate(160, 120)">
    <!-- Main Shell -->
    <rect width="1280" height="660" rx="4" fill="#000000" stroke="#ffffff" stroke-opacity="0.12" stroke-width="1"/>
    
    <!-- Top Nav Bar -->
    <rect width="1280" height="56" fill="#0c0c0e" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1"/>
    <text x="36" y="34" fill="#ffffff" font-family="sans-serif" font-weight="600" font-size="14" letter-spacing="1">INSTITUTIONAL ERP</text>
    <text x="210" y="34" fill="#737373" font-family="monospace" font-size="12">CORE SYSTEM // SHARD CLUSTER 04</text>
    
    <rect x="1100" y="16" width="140" height="24" rx="2" fill="#1c1917" stroke="#d4af37" stroke-opacity="0.4"/>
    <text x="1170" y="32" fill="#d4af37" font-family="monospace" font-size="10" text-anchor="middle" letter-spacing="1">UPTIME 99.998%</text>

    <!-- Left Sidebar Topology Mock -->
    <rect x="36" y="86" width="280" height="530" fill="#08080a" stroke="#ffffff" stroke-opacity="0.06"/>
    <text x="56" y="120" fill="#a3a3a3" font-family="monospace" font-size="11" letter-spacing="2">SYSTEM SERVICES</text>
    
    <g transform="translate(56, 140)">
      <rect width="240" height="42" fill="#171717" stroke="#ffffff" stroke-opacity="0.08"/>
      <text x="14" y="26" fill="#ffffff" font-family="sans-serif" font-size="12">Identity &amp; RBAC</text>
      
      <rect y="54" width="240" height="42" fill="#121214" stroke="#ffffff" stroke-opacity="0.04"/>
      <text x="14" y="80" fill="#a3a3a3" font-family="sans-serif" font-size="12">Academic Registrar</text>
      
      <rect y="108" width="240" height="42" fill="#121214" stroke="#ffffff" stroke-opacity="0.04"/>
      <text x="14" y="134" fill="#a3a3a3" font-family="sans-serif" font-size="12">Financial Ledger</text>
      
      <rect y="162" width="240" height="42" fill="#121214" stroke="#ffffff" stroke-opacity="0.04"/>
      <text x="14" y="188" fill="#a3a3a3" font-family="sans-serif" font-size="12">Compliance Audit</text>
    </g>

    <!-- Center Main Panel: Cloud Cluster Topology Diagram -->
    <rect x="340" y="86" width="890" height="340" fill="#060608" stroke="#ffffff" stroke-opacity="0.06"/>
    <text x="370" y="120" fill="#a3a3a3" font-family="monospace" font-size="11" letter-spacing="2">HIGH-AVAILABILITY MULTI-REGION TOPOLOGY</text>

    <!-- Cluster Nodes -->
    <g transform="translate(420, 160)">
      <!-- Master Node -->
      <circle cx="200" cy="100" r="28" fill="#171717" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.5"/>
      <text x="200" y="105" fill="#ffffff" font-family="monospace" font-size="11" text-anchor="middle">PRIMARY</text>
      
      <!-- Connectors -->
      <line x1="228" y1="100" x2="450" y2="50" stroke="#d4af37" stroke-opacity="0.6" stroke-dasharray="4,4"/>
      <line x1="228" y1="100" x2="450" y2="150" stroke="#d4af37" stroke-opacity="0.6" stroke-dasharray="4,4"/>
      <line x1="172" y1="100" x2="30" y2="100" stroke="#ffffff" stroke-opacity="0.2"/>

      <!-- Edge Replicas -->
      <circle cx="470" cy="50" r="22" fill="#0f0f11" stroke="#d4af37" stroke-width="1.5"/>
      <text x="470" y="54" fill="#d4af37" font-family="monospace" font-size="9" text-anchor="middle">REPLICA A</text>

      <circle cx="470" cy="150" r="22" fill="#0f0f11" stroke="#d4af37" stroke-width="1.5"/>
      <text x="470" y="154" fill="#d4af37" font-family="monospace" font-size="9" text-anchor="middle">REPLICA B</text>

      <!-- Gateway -->
      <rect x="-40" y="80" width="70" height="40" rx="2" fill="#141416" stroke="#ffffff" stroke-opacity="0.3"/>
      <text x="-5" y="104" fill="#ffffff" font-family="monospace" font-size="9" text-anchor="middle">GATEWAY</text>
    </g>

    <!-- Bottom Metrics Panels -->
    <g transform="translate(340, 446)">
      <rect width="280" height="170" fill="#0a0a0c" stroke="#ffffff" stroke-opacity="0.06"/>
      <text x="24" y="36" fill="#737373" font-family="monospace" font-size="11">TRANSACTION LOAD</text>
      <text x="24" y="80" fill="#ffffff" font-family="sans-serif" font-weight="300" font-size="32">48,200/s</text>
      <text x="24" y="112" fill="#10b981" font-family="monospace" font-size="11">↑ 14.8% PEAK SURGE CAPACITY</text>

      <rect x="305" width="280" height="170" fill="#0a0a0c" stroke="#ffffff" stroke-opacity="0.06"/>
      <text x="24" y="36" fill="#737373" font-family="monospace" font-size="11">DATABASE P99 LATENCY</text>
      <text x="24" y="80" fill="#ffffff" font-family="sans-serif" font-weight="300" font-size="32">1.82 ms</text>
      <text x="24" y="112" fill="#a3a3a3" font-family="monospace" font-size="11">ISOLATED READ REPLICAS</text>

      <rect x="610" width="280" height="170" fill="#0a0a0c" stroke="#ffffff" stroke-opacity="0.06"/>
      <text x="24" y="36" fill="#737373" font-family="monospace" font-size="11">ACTIVE ENTERPRISE TENANTS</text>
      <text x="24" y="80" fill="#ffffff" font-family="sans-serif" font-weight="300" font-size="32">142</text>
      <text x="24" y="112" fill="#d4af37" font-family="monospace" font-size="11">SOC-2 TYPE II COMPLIANT</text>
    </g>
  </g>
</svg>
